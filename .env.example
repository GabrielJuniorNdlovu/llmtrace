# ============================================================================
# LLMTrace — Environment Configuration
# ============================================================================
#
# Copy this file:  cp .env.example .env
# Then:            docker compose up -d
#
# These variables configure both Docker Compose services AND the LLMTrace proxy.
# Inside Compose, use service DNS names (postgres, clickhouse, redis). For a
# host-side `cargo run` against published ports, switch those URLs to localhost.
# ============================================================================

# ---------------------------------------------------------------------------
# Storage Profile
# ---------------------------------------------------------------------------
# "lite" = SQLite (zero infra, just run the binary)
# "memory" = in-memory (tests, ephemeral)
# "production" = ClickHouse + PostgreSQL + Redis (docker compose up)
LLMTRACE_STORAGE_PROFILE=production

# ---------------------------------------------------------------------------
# ClickHouse (trace/span analytical storage)
# ---------------------------------------------------------------------------
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=llmtrace
# Compose service hostname (not localhost — the proxy runs inside Docker).
LLMTRACE_CLICKHOUSE_URL=http://clickhouse:8123
LLMTRACE_CLICKHOUSE_DATABASE=llmtrace

# ---------------------------------------------------------------------------
# PostgreSQL (tenant metadata, configs, audit trail)
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=llmtrace
POSTGRES_PASSWORD=llmtrace
POSTGRES_DB=llmtrace
LLMTRACE_POSTGRES_URL=postgres://llmtrace:llmtrace@postgres:5432/llmtrace

# ---------------------------------------------------------------------------
# Redis (cache, cost tracking, sessions)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
LLMTRACE_REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------
LLMTRACE_LISTEN_ADDR=0.0.0.0:8080
LLMTRACE_UPSTREAM_URL=https://api.openai.com

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Require API-key / session auth on the proxy. Keep enabled whenever the
# dashboard login gate is on, otherwise admin-key login cannot be verified.
LLMTRACE_AUTH_ENABLED=1
# Bootstrap operator admin key used by "Sign in with admin key".
# Change this before any shared or production deployment.
LLMTRACE_AUTH_ADMIN_KEY=llmt_local_admin_change_me
# Dashboard login gate (0 = show signup/login, 1 = skip login for local demos).
LLMTRACE_DASHBOARD_AUTH_DISABLED=0
LLMTRACE_DASHBOARD_ADMIN_USERNAME=admin

# Google OAuth (optional). Create an OAuth 2.0 Web client in Google Cloud
# Console with redirect URI:
#   http://localhost:3000/api/auth/google/callback
LLMTRACE_GOOGLE_CLIENT_ID=
LLMTRACE_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LLMTRACE_LOG_LEVEL=info
LLMTRACE_LOG_FORMAT=text
# Fine-grained: RUST_LOG=llmtrace_proxy=debug,info

# ---------------------------------------------------------------------------
# SQLite (only used when LLMTRACE_STORAGE_PROFILE=lite)
# ---------------------------------------------------------------------------
LLMTRACE_STORAGE_DATABASE_PATH=llmtrace.db
